<EmberWormhole @to="sidebar-menu-items">
    <Layout::Sidebar::Panel @title={{t "quickbooks.menu.settings"}} @open={{true}}>
        <Layout::Sidebar::Item @route="console.quickbooks.settings" @icon="gear">{{t "quickbooks.connection.title"}}</Layout::Sidebar::Item>
        <Layout::Sidebar::Item @route="console.quickbooks.activity" @icon="list">{{t "quickbooks.activity.title"}}</Layout::Sidebar::Item>
    </Layout::Sidebar::Panel>
</EmberWormhole>

<Layout::Section::Container>
    {{outlet}}
</Layout::Section::Container>
