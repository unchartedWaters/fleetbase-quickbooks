<ContentPanel
    @title={{t "quickbooks.activity.title"}}
    @open={{true}}
    @wrapperClass="bordered-classic min-w-0 max-w-full"
    @containerClass="min-w-0 max-w-full"
    @panelClass="min-w-0 max-w-full"
    @panelBodyClass="min-w-0 max-w-full"
    @panelBodyWrapperClass="min-w-0 max-w-full"
>
    <section class="quickbooks-activity min-w-0 max-w-full overflow-x-auto" data-test-activity>
        {{#if this.loadFailed}}
            <p id={{this.loadFailedId}} class="text-sm text-gray-500 dark:text-gray-400" role="alert" tabindex="-1" data-test-activity-load-failed>{{t "quickbooks.activity.load-failed"}}</p>
        {{/if}}
        {{#if this.rows.length}}
            <table class="w-full whitespace-nowrap text-sm">
                <thead>
                    <tr class="text-left text-gray-500 border-b">
                        <th scope="col" class="py-2 pr-4 font-medium">{{t "quickbooks.activity.columns.when"}}</th>
                        <th scope="col" class="py-2 pr-4 font-medium">{{t "quickbooks.activity.columns.trigger"}}</th>
                        <th scope="col" class="py-2 pr-4 font-medium">{{t "quickbooks.activity.columns.status"}}</th>
                        <th scope="col" class="py-2 pr-4 font-medium">{{t "quickbooks.activity.columns.direction"}}</th>
                        <th scope="col" class="py-2 font-medium">{{t "quickbooks.activity.columns.results"}}</th>
                    </tr>
                </thead>
                <tbody>
                    {{#each this.rows key="id" as |row|}}
                        <tr data-test-activity-row data-direction={{row.direction}} class="border-b">
                            <td class="py-2 pr-4">{{row.when}}</td>
                            <th scope="row" id={{row.headerId}} class="py-2 pr-4 text-left font-normal" data-test-activity-trigger>{{row.trigger}}</th>
                            <td class="py-2 pr-4" data-test-activity-status>{{row.status}}</td>
                            <td class="py-2 pr-4">{{row.directionLabel}}</td>
                            <td class="py-2 whitespace-normal" data-test-activity-results>{{row.resultsText}}</td>
                        </tr>
                        {{#if row.error}}
                            <tr>
                                <td colspan="5" headers={{row.headerId}} class="pb-2 whitespace-normal break-words text-red-600 dark:text-red-400" data-test-activity-error>{{row.error}}</td>
                            </tr>
                        {{/if}}
                    {{/each}}
                </tbody>
            </table>
        {{else if this.showEmptyState}}
            <p class="text-sm text-gray-500" data-test-activity-empty>{{t "quickbooks.activity.empty"}}</p>
        {{else if this.isLoading}}
            <p class="text-sm text-gray-500" data-test-activity-loading>{{t "quickbooks.activity.loading"}}</p>
        {{/if}}
        {{#if this.showPagination}}
            {{#each this.pagerKeys key="@identity"}}
                <Pagination @meta={{this.paginationMeta}} @currentPage={{this.currentPage}} @onPageChange={{this.changePage}} />
            {{/each}}
        {{/if}}
    </section>
</ContentPanel>