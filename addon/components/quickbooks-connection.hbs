{{#if (eq @variant "status")}}
    <div data-test-connection-state={{this.state}}>
        <ContentPanel @title={{t "quickbooks.connection.title"}} @open={{true}} @wrapperClass="bordered-classic">
            {{#if this.loadFailed}}
                <p class="text-sm text-gray-500 mb-4" data-test-status-unavailable>{{t "quickbooks.connection.unavailable"}}</p>
            {{else if this.isLoading}}
                <p class="text-sm text-gray-500 mb-4" data-test-connection-loading>{{t "quickbooks.connection.loading"}}</p>
            {{else if this.needsReauth}}
                <p class="text-sm text-red-600 dark:text-red-400 mb-4" data-test-reauth>
                    {{#if this.isConfigured}}
                        {{t "quickbooks.connection.reauth-status"}}
                    {{else}}
                        {{t "quickbooks.connection.reauth-save-first"}}
                    {{/if}}
                </p>
            {{else if this.isConnected}}
                <p class="text-sm text-gray-500 mb-4" data-test-connected>
                    {{#if @connection.environment}}
                        {{t "quickbooks.connection.connected" realm=@connection.realm_id environment=@connection.environment}}
                    {{else}}
                        {{t "quickbooks.connection.connected-plain" realm=@connection.realm_id}}
                    {{/if}}
                </p>
                {{#if @connection.home_currency}}
                    <div class="text-sm text-gray-500 mb-4" data-test-home-currency>
                        <p>{{t "quickbooks.connection.home-currency" currency=@connection.home_currency}}</p>
                        <ul class="list-disc pl-5 mt-2 space-y-1">
                            <li>{{t "quickbooks.connection.home-currency-where"}}</li>
                            <li>{{t "quickbooks.connection.home-currency-invoices"}}</li>
                            <li>{{t "quickbooks.connection.home-currency-wallet"}}</li>
                            <li>{{t "quickbooks.connection.home-currency-existing"}}</li>
                            <li>{{t "quickbooks.connection.home-currency-primary"}}</li>
                        </ul>
                    </div>
                {{/if}}
            {{else}}
                <p class="text-sm text-gray-500 mb-4" data-test-disconnected>
                    {{#if this.isConfigured}}
                        {{t "quickbooks.connection.disconnected-status"}}
                    {{else}}
                        {{t "quickbooks.connection.disconnected-save-first"}}
                    {{/if}}
                </p>
            {{/if}}

            {{#unless this.isLoading}}
                {{#unless this.loadFailed}}
                    <div class="flex flex-wrap gap-2" data-test-connection-actions>
                        <Button
                            @type="primary"
                            @size="sm"
                            @icon="play"
                            @text={{t "quickbooks.actions.sync-now"}}
                            @disabled={{this.syncDisabled}}
                            @onClick={{this.syncNow}}
                            data-test-sync-now
                        />
                        <Button
                            @type="primary"
                            @size="sm"
                            @icon="plug"
                            @text={{t "quickbooks.connection.connect"}}
                            @disabled={{this.connectDisabled}}
                            @onClick={{this.connect}}
                            data-test-connect
                        />
                        <Button
                            @type="default"
                            @size="sm"
                            @icon="unlink"
                            @text={{t "quickbooks.connection.disconnect"}}
                            @disabled={{this.disconnectDisabled}}
                            @onClick={{this.disconnect}}
                            data-test-disconnect
                        />
                        {{#if this.credentialsMissing}}
                            <p class="text-sm text-gray-500 dark:text-gray-400" data-test-credentials-missing>
                                {{t "quickbooks.widget.credentials-missing"}}
                            </p>
                        {{/if}}
                        {{#if this.syncPermissionDenied}}
                            <p class="text-sm text-gray-500 dark:text-gray-400" data-test-sync-denied>
                                {{t "quickbooks.actions.sync-denied"}}
                            </p>
                        {{/if}}
                    </div>
                {{/unless}}
            {{/unless}}
        </ContentPanel>
    </div>
{{/if}}