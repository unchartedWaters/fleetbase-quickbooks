<Layout::Section::Header @title={{t "quickbooks.actions.title"}} />

<Layout::Section::Body class="overflow-y-scroll h-full">
    <div class="container mx-auto h-screen">
        <div class="max-w-3xl my-10 mx-auto space-y-6">
            <QuickbooksConnection
                @connection={{this.connection}}
                @configured={{this.configured}}
                @loadFailed={{this.summaryLoadFailed}}
                @busy={{this.busy}}
                @onReconcile={{this.reconcile}}
                @onImport={{this.importCustomers}}
                @onSync={{this.sync}}
            />
        </div>
        <Spacer @height="600px" />
    </div>
</Layout::Section::Body>
