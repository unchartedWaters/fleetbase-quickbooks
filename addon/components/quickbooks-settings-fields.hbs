<div class="space-y-6">
    {{#unless @syncOnly}}
    <ContentPanel @title={{t "quickbooks.settings.authentication"}} @open={{true}} @wrapperClass="bordered-classic">
        <InfoBlock @type="info" @icon="circle-info" class="mb-4" data-test-credentials-guidance>
            <div class="font-semibold">{{t "quickbooks.settings.credentials-title"}}</div>
            <p class="mt-1" data-test-create-app-step>{{t "quickbooks.settings.credentials-create-app-before"}}<a
                    href="https://developer.intuit.com/app/developer/qbo/docs/get-started/start-developing-your-app"
                    target="_blank"
                    rel="noopener noreferrer"
                    class="quickbooks-guidance-link text-inherit cursor-pointer underline"
                >{{t "quickbooks.settings.credentials-create-app-link"}}</a>{{t "quickbooks.settings.credentials-create-app-after"}}</p>
            <ol class="mt-1 list-decimal space-y-1 pl-5">
                <li data-test-keys-step>{{t "quickbooks.settings.credentials-step-keys-before"}}<a
                        href="https://developer.intuit.com"
                        target="_blank"
                        rel="noopener noreferrer"
                        class="quickbooks-guidance-link text-inherit cursor-pointer underline"
                    >{{t "quickbooks.settings.credentials-step-keys-link"}}</a>{{t "quickbooks.settings.credentials-step-keys-after"}}</li>
                <li>{{t "quickbooks.settings.credentials-step-form"}}</li>
                <li data-test-redirect-step>{{t "quickbooks.settings.credentials-step-redirect"}}</li>
                <li data-test-webhook-step>{{t "quickbooks.settings.credentials-step-webhook"}}</li>
                <li data-test-credential-save-step>{{t "quickbooks.settings.credentials-step-save"}}</li>
            </ol>
        </InfoBlock>
        {{#each @authFields key="key" as |field|}}
            <div data-test-sync-field={{field.key}}>
                {{#if (eq field.key "environment")}}
                    <InputGroup @name={{field.label}} @required={{true}} as |id|>
                        <select
                            id={{id}}
                            class="form-select form-input w-full {{if (get @errors field.key) 'border-red-500 dark:border-red-400'}}"
                            style={{if (get @errors field.key) "border-color:#dc2626"}}
                            disabled={{@readOnly}}
                            data-test-field={{field.key}}
                            aria-invalid={{if (get @errors field.key) "true"}}
                            aria-describedby={{if (get @errors field.key) (concat field.key "-error")}}
                            {{on "change" (fn @onUpdate field.key)}}
                        >
                            <option value="sandbox" selected={{eq field.value "sandbox"}}>{{t "quickbooks.settings.options.sandbox"}}</option>
                            <option value="production" selected={{eq field.value "production"}}>{{t "quickbooks.settings.options.production"}}</option>
                        </select>
                        {{#if (get @errors field.key)}}
                            <p id={{concat field.key "-error"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{field.key}} tabindex="-1">{{get @errors field.key}}</p>
                        {{/if}}
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help={{field.key}}>{{field.hint}}</p>
                    </InputGroup>
                {{else}}
                    <InputGroup @name={{field.label}} @required={{true}} as |id|>
                        <Input
                            id={{id}}
                            @type="text"
                            @value={{field.value}}
                            class="w-full form-input {{if (get @errors field.key) 'border-red-500 dark:border-red-400'}}"
                            style={{if (get @errors field.key) "border-color:#dc2626"}}
                            autocomplete="off"
                            disabled={{@readOnly}}
                            data-test-field={{field.key}}
                            aria-invalid={{if (get @errors field.key) "true"}}
                            aria-describedby={{if (get @errors field.key) (concat field.key "-error")}}
                            {{on "input" (fn @onUpdate field.key)}}
                        />
                        {{#if (get @errors field.key)}}
                            <p id={{concat field.key "-error"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{field.key}} tabindex="-1">{{get @errors field.key}}</p>
                        {{/if}}
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help={{field.key}}>{{field.hint}}</p>
                    </InputGroup>
                {{/if}}
            </div>
        {{/each}}
        <InputGroup @name={{t "quickbooks.settings.client-secret"}} @required={{true}} as |id|>
            <div class="flex items-center gap-2">
                <Input
                    id={{id}}
                    @type={{if @secret.visible "text" "password"}}
                    @value={{@secret.value}}
                    class="w-full form-input {{if (get @errors 'client_secret') 'border-red-500 dark:border-red-400'}}"
                    style={{if (get @errors "client_secret") "border-color:#dc2626"}}
                    autocomplete="new-password"
                    spellcheck="false"
                    autocapitalize="off"
                    placeholder={{if @secret.set (t "quickbooks.settings.secret-mask" hint=@secret.hint) ""}}
                    disabled={{@readOnly}}
                    data-test-field="client_secret"
                    aria-invalid={{if (get @errors "client_secret") "true"}}
                    aria-describedby={{if (get @errors "client_secret") "client-secret-error"}}
                    {{on "input" (fn @onUpdate "client_secret")}}
                />
                <button
                    type="button"
                    class="btn btn-default btn-md"
                    aria-controls={{id}}
                    aria-pressed={{if @secret.visible "true" "false"}}
                    aria-label={{t (if @secret.visible "quickbooks.settings.hide-value" "quickbooks.settings.show-value") field=(t "quickbooks.settings.client-secret")}}
                    data-test-toggle-visibility="client_secret"
                    {{on "click" (fn @onToggleVisibility "client_secret")}}
                ><FaIcon @icon={{if @secret.visible "eye-slash" "eye"}} /></button>
            </div>
            {{#if (get @errors "client_secret")}}
                <p id="client-secret-error" class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error="client_secret" tabindex="-1">{{get @errors "client_secret"}}</p>
            {{/if}}
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help="client_secret">{{t "quickbooks.settings.client-secret-help"}}</p>
        </InputGroup>
        {{#if (not (get @errors "client_secret"))}}
            {{#if @secret.set}}
                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-secret-set>{{t "quickbooks.settings.client-secret-saved"}}</p>
            {{/if}}
        {{/if}}
        <InputGroup @name={{t "quickbooks.settings.verifier"}} as |id|>
            <div class="flex items-center gap-2">
                <Input
                    id={{id}}
                    @type={{if @secret.verifier.visible "text" "password"}}
                    @value={{@secret.verifier.value}}
                    class="w-full form-input {{if (get @errors 'webhook_verifier') 'border-red-500 dark:border-red-400'}}"
                    style={{if (get @errors "webhook_verifier") "border-color:#dc2626"}}
                    autocomplete="new-password"
                    spellcheck="false"
                    autocapitalize="off"
                    placeholder={{if @secret.verifier.set (t "quickbooks.settings.secret-mask" hint=@secret.verifier.hint) ""}}
                    disabled={{@readOnly}}
                    data-test-field="webhook_verifier"
                    aria-invalid={{if (get @errors "webhook_verifier") "true"}}
                    aria-describedby={{if (get @errors "webhook_verifier") "webhook-verifier-error"}}
                    {{on "input" (fn @onUpdate "webhook_verifier")}}
                />
                <button
                    type="button"
                    class="btn btn-default btn-md"
                    aria-controls={{id}}
                    aria-pressed={{if @secret.verifier.visible "true" "false"}}
                    aria-label={{t (if @secret.verifier.visible "quickbooks.settings.hide-value" "quickbooks.settings.show-value") field=(t "quickbooks.settings.verifier")}}
                    data-test-toggle-visibility="webhook_verifier"
                    {{on "click" (fn @onToggleVisibility "webhook_verifier")}}
                ><FaIcon @icon={{if @secret.verifier.visible "eye-slash" "eye"}} /></button>
            </div>
            {{#if (get @errors "webhook_verifier")}}
                <p id="webhook-verifier-error" class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error="webhook_verifier" tabindex="-1">{{get @errors "webhook_verifier"}}</p>
            {{/if}}
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help="webhook_verifier">
                {{t "quickbooks.settings.verifier-help"}}
            </p>
        </InputGroup>
        {{#if @secret.verifier.set}}
            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-verifier-set>{{t "quickbooks.settings.verifier-saved"}}</p>
        {{/if}}
        {{#each @displayedUrls key="key" as |url|}}
            <div data-test-sync-field={{url.key}}>
                {{#if url.editable}}
                    <InputGroup @name={{url.label}} as |id|>
                        <Input
                            id={{id}}
                            @type="text"
                            @value={{url.value}}
                            class="w-full form-input {{if (get @errors url.key) 'border-red-500 dark:border-red-400'}}"
                            style={{if (get @errors url.key) "border-color:#dc2626"}}
                            disabled={{@readOnly}}
                            data-test-field={{url.key}}
                            aria-invalid={{if (get @errors url.key) "true"}}
                            aria-describedby={{if (get @errors url.key) (concat url.key "-error")}}
                            {{on "input" (fn @onUpdate url.key)}}
                        />
                        {{#if (get @errors url.key)}}
                            <p id={{concat url.key "-error"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{url.key}} tabindex="-1">{{get @errors url.key}}</p>
                        {{/if}}
                        <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help={{url.key}}>{{url.hint}}</p>
                        {{#if url.notPublic}}
                            <p class="text-xs text-amber-700 dark:text-amber-400 mt-1" data-test-url-not-public={{url.key}}>{{t "quickbooks.settings.urls.not-public"}}</p>
                        {{/if}}
                    </InputGroup>
                {{else}}
                    <div class="mb-4 border-l-2 border-gray-200 pl-3 dark:border-gray-700">
                        <p class="text-xs font-medium text-gray-500 dark:text-gray-400" data-test-url-label>{{url.label}}</p>
                        <div class="mt-1 select-text break-all font-mono text-xs leading-5 text-gray-600 dark:text-gray-300" data-test-field={{url.key}}>{{url.value}}</div>
                        <p class="mt-1 text-xs text-gray-500 dark:text-gray-400" data-test-field-help={{url.key}}>{{url.hint}}</p>
                    </div>
                {{/if}}
            </div>
        {{/each}}
    </ContentPanel>
    {{/unless}}

    <ContentPanel @title={{t "quickbooks.settings.schedule"}} @open={{true}} @wrapperClass="bordered-classic">
        {{#each @syncFields key="key" as |field|}}
            <div data-test-sync-field={{field.key}}>
                <InputGroup @name={{field.label}} @required={{true}} as |id|>
                    <Input
                        id={{id}}
                        @type={{field.type}}
                        @value={{field.value}}
                        min={{field.min}}
                        disabled={{@readOnly}}
                        class="w-full form-input {{if (get @errors field.key) 'border-red-500 dark:border-red-400'}}"
                        style={{if (get @errors field.key) "border-color:#dc2626"}}
                        data-test-sync={{field.key}}
                        data-test-sync-label={{field.key}}
                        aria-label={{field.label}}
                        aria-invalid={{if (get @errors field.key) "true"}}
                        aria-describedby={{if (get @errors field.key) (concat field.key "-sync-error")}}
                        {{on "input" (fn @onUpdate field.key)}}
                    />
                    {{#if (get @errors field.key)}}
                        <p id={{concat field.key "-sync-error"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{field.key}} tabindex="-1">{{get @errors field.key}}</p>
                    {{/if}}
                    <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help={{field.key}}>{{field.hint}}</p>
                </InputGroup>
            </div>
        {{/each}}
    </ContentPanel>

    <div data-test-data-resolution data-test-data-resolution-description>
        <ContentPanel
            @title={{t "quickbooks.settings.data-resolution"}}
            @helpText={{t "quickbooks.settings.data-resolution-description"}}
            @tooltipPlacement="bottom"
            @open={{true}}
            @wrapperClass="bordered-classic"
        >
            <:default>
                {{#each @policies key="entity" as |policy|}}
                    <div class="mb-6" data-test-policy={{policy.entity}}>
                        <div class="mb-2" data-test-sync-field={{policy.enabledKey}}>
                            <Toggle
                                @isToggled={{policy.enabled}}
                                @onToggle={{fn @onSetEntityEnabled policy.entity}}
                                @disabled={{@readOnly}}
                                @label={{policy.label}}
                                aria-label={{policy.label}}
                                aria-checked={{if policy.enabled "true" "false"}}
                                aria-disabled={{if @readOnly "true"}}
                                tabindex={{if @readOnly "-1" "0"}}
                                data-test-sync={{policy.enabledKey}}
                                {{on "keydown" @onToggleKey}}
                            />
                        </div>
                        <InputGroup @name={{t "quickbooks.settings.primary"}} @required={{policy.enabled}} as |id|>
                            <select
                                id={{id}}
                                aria-label={{t "quickbooks.settings.entity-primary" entity=policy.label}}
                                class="form-select form-input w-full {{if (or (get @errors policy.conflictKey) (get @errors policy.referenceKey)) 'border-red-500 dark:border-red-400'}}"
                                style={{if (or (get @errors policy.conflictKey) (get @errors policy.referenceKey)) "border-color:#dc2626"}}
                                disabled={{or @readOnly (not policy.enabled)}}
                                data-test-sync={{policy.conflictKey}}
                                aria-invalid={{if (or (get @errors policy.conflictKey) (get @errors policy.referenceKey)) "true"}}
                                aria-describedby={{if
                                    (or (get @errors policy.conflictKey) (get @errors policy.referenceKey))
                                    (concat
                                        (if (get @errors policy.conflictKey) (concat id "-conflict"))
                                        (if (and (get @errors policy.conflictKey) (get @errors policy.referenceKey)) " ")
                                        (if (get @errors policy.referenceKey) (concat id "-reference"))
                                    )
                                }}
                                {{on "change" (fn @onUpdate policy.entity)}}
                            >
                                <option value="fleetbase" selected={{eq policy.primary "fleetbase"}}>{{t "quickbooks.settings.options.fleetbase"}}</option>
                                <option value="quickbooks" selected={{eq policy.primary "quickbooks"}}>{{t "quickbooks.settings.options.quickbooks"}}</option>
                            </select>
                            {{#if (get @errors policy.conflictKey)}}
                                <p id={{concat id "-conflict"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{policy.conflictKey}} tabindex="-1">{{get @errors policy.conflictKey}}</p>
                            {{/if}}
                            {{#if (get @errors policy.referenceKey)}}
                                <p id={{concat id "-reference"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{policy.referenceKey}} tabindex="-1">{{get @errors policy.referenceKey}}</p>
                            {{/if}}
                            <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help="primary">{{t "quickbooks.settings.primary-help"}}</p>
                        </InputGroup>
                        <div data-test-sync-field={{policy.directionKey}}>
                            <InputGroup @name={{t "quickbooks.settings.sync-direction"}} @required={{policy.enabled}} as |id|>
                                <select
                                    id={{id}}
                                    aria-label={{t "quickbooks.settings.entity-sync-direction" entity=policy.label}}
                                    class="form-select form-input w-full {{if (get @errors policy.directionKey) 'border-red-500 dark:border-red-400'}}"
                                    style={{if (get @errors policy.directionKey) "border-color:#dc2626"}}
                                    disabled={{or @readOnly (not policy.enabled)}}
                                    data-test-sync={{policy.directionKey}}
                                    aria-invalid={{if (get @errors policy.directionKey) "true"}}
                                    aria-describedby={{if (get @errors policy.directionKey) (concat policy.directionKey "-error")}}
                                    {{on "change" (fn @onUpdate policy.directionKey)}}
                                >
                                    <option value="both" selected={{eq policy.direction "both"}}>{{t "quickbooks.settings.options.both"}}</option>
                                    <option value="outbound" selected={{eq policy.direction "outbound"}}>{{t "quickbooks.settings.options.outbound"}}</option>
                                    <option value="inbound" selected={{eq policy.direction "inbound"}}>{{t "quickbooks.settings.options.inbound"}}</option>
                                </select>
                                {{#if (get @errors policy.directionKey)}}
                                    <p id={{concat policy.directionKey "-error"}} class="text-xs text-red-600 dark:text-red-400 mt-1" data-test-error={{policy.directionKey}} tabindex="-1">{{get @errors policy.directionKey}}</p>
                                {{/if}}
                                <p class="text-xs text-gray-500 dark:text-gray-400 mt-1" data-test-field-help="sync_direction">{{t "quickbooks.settings.sync-direction-help"}}</p>
                            </InputGroup>
                        </div>
                    </div>
                {{/each}}
            </:default>
        </ContentPanel>
    </div>
</div>