<div class="quickbooks-widget flex h-full flex-col rounded-md border bg-white shadow-sm dark:bg-gray-800" ...attributes>
    <div class="quickbooks-widget-header">
        <div class="min-w-0">
            <div class="quickbooks-widget-title">{{t "quickbooks.widget.title"}}</div>
            {{#unless this.noAccess}}
                {{#unless this.isLoading}}
                    {{#unless this.error}}
                        <div class="quickbooks-widget-subtitle" data-test-widget-subtitle>{{this.statusLabel}}</div>
                    {{/unless}}
                {{/unless}}
            {{/unless}}
        </div>
        {{#unless this.noAccess}}
            <button type="button" class="quickbooks-icon-button" {{on "click" this.refresh}} disabled={{this.busy}} aria-label={{t "quickbooks.widget.refresh"}}>
                <FaIcon @icon="rotate" />
            </button>
        {{/unless}}
    </div>

    <div class="quickbooks-widget-body space-y-4">
        {{#if this.noAccess}}
            <div class="quickbooks-widget-empty" data-test-widget-no-access>{{t "quickbooks.widget.no-access"}}</div>
        {{else if this.isLoading}}
            <div class="quickbooks-widget-empty" data-test-widget-loading>{{t "quickbooks.widget.loading"}}</div>
        {{else if this.error}}
            <div class="quickbooks-widget-empty" data-test-widget-empty>{{this.error}}</div>
        {{else}}
            <div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{{t "quickbooks.widget.last-sync"}}</div>
                <div class="text-sm font-medium" data-test-last-sync>{{this.lastSyncLabel}}</div>
            </div>
            <div>
                <div class="text-xs text-gray-500 dark:text-gray-400">{{t "quickbooks.widget.records-waiting"}}</div>
                <div class="text-sm font-medium" data-test-sync-queue>{{t "quickbooks.widget.waiting" count=this.queueCount}}</div>
                {{#if this.failedCount}}
                    <p class="text-sm text-red-600 dark:text-red-400" data-test-sync-failed>{{t "quickbooks.widget.records-failed" count=this.failedCount}}</p>
                {{/if}}
            </div>
            <div class="flex flex-wrap items-center gap-3">
                <Button @type="primary" @size="sm" @icon="play" @text={{t "quickbooks.actions.sync-now"}} @disabled={{this.syncDisabled}} @onClick={{this.sync}} data-test-widget-sync />
                {{#if this.credentialsMissing}}
                    <p class="text-sm text-gray-500 dark:text-gray-400" data-test-widget-credentials-missing>
                        {{t "quickbooks.widget.credentials-missing"}}
                    </p>
                {{/if}}
                {{#if this.reauthReady}}
                    <p class="text-sm text-gray-500 dark:text-gray-400" data-test-widget-reauth>{{t "quickbooks.widget.reauth-setup"}}</p>
                {{/if}}
                {{#if this.reauthPermissionDenied}}
                    <p class="text-sm text-gray-500 dark:text-gray-400" data-test-widget-reauth-denied>{{t "quickbooks.widget.reauth-no-permission"}}</p>
                {{/if}}
                {{#if this.reauthNeedsKeys}}
                    <p class="text-sm text-gray-500 dark:text-gray-400" data-test-widget-reauth-keys>{{t "quickbooks.connection.reauth-save-first"}}</p>
                {{/if}}
                {{#if this.syncPermissionDenied}}
                    <p class="text-sm text-gray-500 dark:text-gray-400" data-test-sync-denied>
                        {{t "quickbooks.actions.sync-denied"}}
                    </p>
                {{/if}}
            </div>
        {{/if}}
    </div>
</div>