<EmberWormhole @to="next-view-section-subheader-actions">
    <div class="flex items-center gap-2">
        {{#if this.showReset}}
            <Button @type="default" @size="sm" @icon="rotate-left" @text={{t "quickbooks.settings.reset"}} @disabled={{this.resetDisabled}} @onClick={{this.reset}} data-test-reset />
        {{/if}}
        <Button @type="primary" @size="sm" @icon="save" @text={{t "quickbooks.settings.save"}} @disabled={{this.saveDisabled}} @isLoading={{this.saving}} @onClick={{this.save}} data-test-save />
    </div>
</EmberWormhole>
<div data-test-settings-scope="admin" class="space-y-6">
    {{! The connection card comes first; the notes below describe the sync settings under them. }}
    {{#unless @hideConnection}}
        <QuickbooksConnection
            @variant="status"
            @connection={{@connection}}
            @configured={{@configured}}
            @canConnectNew={{@canConnectNew}}
            @loadFailed={{@loadFailed}}
            @busy={{@busy}}
            @onConnect={{@onConnect}}
            @onDisconnect={{@onDisconnect}}
            @onSync={{@onSync}}
        />
    {{/unless}}
    {{#if @settingsLoadFailed}}
        <p class="text-sm text-gray-500" data-test-settings-unavailable>{{t "quickbooks.connection.settings-unavailable"}}</p>
    {{/if}}
    {{#if this.showReadOnlyNote}}
        <InfoBlock @type="info" @icon="circle-info" data-test-settings-read-only>{{t "quickbooks.settings.read-only-note"}}</InfoBlock>
    {{/if}}
    {{#if @showTemplateNote}}
        <InfoBlock @type="warning" @icon="triangle-exclamation" class="font-semibold" data-test-admin-template-note>{{t "quickbooks.settings.admin-template-note"}}</InfoBlock>
    {{/if}}
    {{#if this.showCopyNote}}
        {{#if this.hasCopy}}
            <InfoBlock @type="info" @icon="circle-info" data-test-copy-note>{{t "quickbooks.settings.copy-note"}}</InfoBlock>
        {{else}}
            <InfoBlock @type="info" @icon="circle-info" data-test-template-note>{{t "quickbooks.settings.template-note"}}</InfoBlock>
        {{/if}}
    {{/if}}
    <QuickbooksSettingsFields
        @syncOnly={{this.syncOnly}}
        @readOnly={{this.readOnly}}
        @errors={{this.errors}}
        @authFields={{this.authFields}}
        @syncFields={{this.syncFields}}
        @policies={{this.policies}}
        @secret={{this.secret}}
        @displayedUrls={{this.displayedUrls}}
        @onUpdate={{this.update}}
        @onToggleVisibility={{this.toggleVisibility}}
        @onSetEntityEnabled={{this.setEntityEnabled}}
    />
</div>