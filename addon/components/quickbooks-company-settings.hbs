<QuickbooksSettings
    @title={{@title}}
    @scope="company"
    @settings={{this.settings}}
    @sync={{this.sync}}
    @companySettings={{this.companySettings}}
    @companySync={{this.companySync}}
    @connection={{this.connection}}
    @loadFailed={{this.connectionLoadFailed}}
    @settingsLoadFailed={{this.settingsLoadFailed}}
    @settingsLoaded={{this.settingsLoaded}}
    @busy={{this.busy}}
    @onSave={{this.save}}
    @onTest={{this.testConnection}}
    @onConnect={{this.connect}}
    @onDisconnect={{this.disconnect}}
    @configured={{this.configured}}
    @onSync={{this.syncNow}}
    @onReconcile={{this.reconcile}}
    @onImport={{this.importCustomers}}
/>
