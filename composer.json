{
    "name": "unchartedwaters/quickbooks-api",
    "version": "0.0.2",
    "description": "Sync Fleetbase customers, invoices, payments, wallets, and products with QuickBooks Online.",
    "keywords": [
        "fleetbase",
        "fleetbase-extension",
        "invoice",
        "ledger",
        "finance",
        "customer"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "unchartedWaters"
        }
    ],
    "require": {
        "php": "^8.2",
        "fleetbase/core-api": "^2.0.3",
        "fleetbase/fleetops-api": "^0.7.1",
        "fleetbase/ledger-api": "^0.1.0",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*",
        "symfony/yaml": "^6.4|^7.0"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "illuminate/encryption": "^12.0",
        "nunomaduro/collision": "^8.5",
        "pestphp/pest": "^3.8",
        "phpstan/phpstan": "^1.10.38",
        "symfony/var-dumper": "^7.4"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\Quickbooks\\": "server/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Quickbooks\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Quickbooks\\Providers\\QuickbooksServiceProvider"
            ]
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v --dry-run",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=1G",
        "test:unit": "php scripts/pest-runner.php --colors=always --exclude-group=sandbox",
        "test:sandbox": [
            "@putenv QB_SANDBOX_RUN=1",
            "php scripts/pest-runner.php --colors=always --group=sandbox"
        ],
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
