{
    "name": "unchartedwaters/quickbooks-api",
    "version": "0.0.2",
    "description": "Sync Fleetbase customers, invoices, payments, and wallets with QuickBooks Online.",
    "keywords": [
        "fleetbase",
        "fleetbase-extension",
        "invoice",
        "ledger",
        "finance",
        "customer"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "unchartedWaters"
        }
    ],
    "require": {
        "php": "^8.2",
        "fleetbase/core-api": "^1.6",
        "fleetbase/fleetops-api": "0.6.71",
        "fleetbase/ledger-api": "0.0.12",
        "php-http/guzzle7-adapter": "^1.0",
        "psr/http-factory-implementation": "*"
    },
    "require-dev": {
        "friendsofphp/php-cs-fixer": "^3.34.1",
        "illuminate/encryption": "^10.0",
        "nunomaduro/collision": "^5.11.0|^6.4.0",
        "pestphp/pest": "^1.22.6",
        "phpstan/phpstan": "^1.10.38",
        "symfony/var-dumper": "^5.4.29"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\Quickbooks\\": "server/src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Quickbooks\\Tests\\": "server/tests/"
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Quickbooks\\Providers\\QuickbooksServiceProvider"
            ]
        }
    },
    "config": {
        "vendor-dir": "./server_vendor",
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        },
        "policy": {
            "advisories": {
                "ignore-id": {
                    "PKSA-zwc5-qtrz-zm1n": "Inherited CVE-2026-48019 via fleetbase/core-api ^1.6 (newest 1.6.68 still requires illuminate/notifications 9 or 10). Not fixable in this package."
                }
            }
        }
    },
    "scripts": {
        "lint": "php-cs-fixer fix -v --dry-run",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=1G",
        "test:unit": "php scripts/pest-runner.php --colors=always",
        "test": [
            "@test:lint",
            "@test:types",
            "@test:unit"
        ]
    }
}
